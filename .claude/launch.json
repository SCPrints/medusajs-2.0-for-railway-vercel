{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "storefront",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "cwd": "storefront",
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "storefront-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start"],
      "cwd": "storefront",
      "port": 3100,
      "env": { "PORT": "3100" }
    }
  ]
}
