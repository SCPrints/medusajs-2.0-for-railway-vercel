{
  "name": "medusa-2.0-boilerplate-backend",
  "version": "0.0.2",
  "description": "A Prebaked Medusa 2.0 backend",
  "author": "Rasmus Puls",
  "license": "MIT",
  "keywords": [
    "sqlite",
    "postgres",
    "typescript",
    "ecommerce",
    "headless",
    "medusa"
  ],
  "scripts": {
    "build": "npx medusa build && node src/scripts/postBuild.js",
    "seed": "npx medusa exec ./src/scripts/seed.ts",
    "delete-all-products": "npx medusa exec ./src/scripts/delete-all-products.ts --",
    "delete-all-products:apply": "DELETE_PRODUCTS_APPLY=1 npx medusa exec ./src/scripts/delete-all-products.ts",
    "update-as-colour-pricing": "npx medusa exec ./src/scripts/update-as-colour-pricing.ts --",
    "trim-as-colour-catalog": "npx medusa exec ./src/scripts/trim-as-colour-catalog-by-allowlist.ts --",
    "trim-syzmik-catalog": "npx medusa exec ./src/scripts/trim-syzmik-catalog-by-allowlist.ts --",
    "trim-ramo-catalog": "npx medusa exec ./src/scripts/trim-ramo-catalog-by-allowlist.ts --",
    "import-dnc-products": "npx medusa exec ./src/scripts/import-dnc-products.ts --",
    "import-ramo-from-csv": "npx medusa exec ./src/scripts/import-ramo-from-csv.ts --",
    "backfill-ramo-cdn-images": "npx medusa exec ./src/scripts/_backfill-ramo-cdn-images.ts --",
    "backfill-dnc-csv-images": "npx medusa exec ./src/scripts/_backfill-dnc-csv-images.ts --",
    "generate-as-colour-website-pricing-import-csv": "node -r ts-node/register/transpile-only ./src/scripts/generate-as-colour-website-pricing-import-csv.ts --",
    "audit-pricing-csv": "node -r ts-node/register/transpile-only ./src/scripts/audit-wholesale-pricing-csv.ts --",
    "generate-as-colour-gold-import-csv": "node -r ts-node/register/transpile-only ./src/scripts/generate-as-colour-gold-import-csv.ts --",
    "strip-product-import-supplemental": "node -r ts-node/register/transpile-only ./src/scripts/strip-product-import-supplemental-columns.ts --",
    "import-tidied-types-tags": "npx medusa exec ./src/scripts/import-tidied-types-and-tags-csv.ts --",
    "list-product-types-tags": "npx medusa exec ./src/scripts/list-product-types-and-tags.ts --",
    "start": "cd .medusa/server && npx medusa start --verbose",
    "dev": "npx medusa develop",
    "apply-garment-images-from-csv": "npx medusa exec ./src/scripts/apply-garment-images-from-template-csv.ts",
    "test": "jest --config jest.config.cjs",
    "email:dev": "email dev --dir=./src/modules/email-notifications/templates --port=3002"
  },
  "dependencies": {
    "@alphabite/medusa-paypal": "^0.2.6",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@google-analytics/data": "^5.2.2",
    "@medusajs/admin-sdk": "2.21.2",
    "@medusajs/admin-shared": "2.21.2",
    "@medusajs/cli": "2.21.2",
    "@medusajs/dashboard": "2.21.2",
    "@medusajs/draft-order": "2.21.2",
    "@medusajs/framework": "2.21.2",
    "@medusajs/icons": "2.21.2",
    "@medusajs/js-sdk": "2.21.2",
    "@medusajs/locking-redis": "2.21.2",
    "@medusajs/medusa": "2.21.2",
    "@medusajs/payment-stripe": "2.21.2",
    "@medusajs/ui": "4.2.6",
    "@medusajs/workflow-engine-redis": "2.21.2",
    "@rokmohar/medusa-plugin-meilisearch": "2.3.1",
    "@upstash/context7-sdk": "^0.3.1",
    "googleapis": "^144.0.0",
    "mermaid": "^11.17.2",
    "minio": "^8.0.7",
    "pdf-lib": "1.17.1",
    "pdfkit": "^0.18.0",
    "pg": "^8.23.1",
    "posthog-node": "^5.57.1",
    "react-email": "^6.11.3",
    "recharts": "3.8.1",
    "resend": "6.12.3",
    "sharp": "^0.35.5",
    "stripe": "^23.0.1",
    "ulid": "^3.0.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@medusajs/test-utils": "2.21.2",
    "@swc/core": "1.5.7",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "jest": "^29.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "packageManager": "pnpm@9.10.0",
  "engines": {
    "node": ">=22.12.0",
    "npm": "10.x"
  },
  "pnpm": {
    "patchedDependencies": {
      "@medusajs/dashboard@2.21.2": "patches/@medusajs__dashboard@2.21.2.patch"
    },
    "overrides": {
      "lodash@<4.18.0": "^4.18.1",
      "ajv@>=7 <8.18.0": "^8.18.0",
      "zod@>=4 <4.6.6": "^4.6.7",
      "uuid@>=9 <11.1.1": "^11.1.1",
      "katex@<0.18.2": "^0.18.2",
      "@graphql-tools/utils@<12.0.2": "^12.0.2",
      "postcss-selector-parser@<7.1.6": "^7.1.6",
      "@opentelemetry/instrumentation-pg@<0.73.0": "^0.73.0"
    }
  }
}
